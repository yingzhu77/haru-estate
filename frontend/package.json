  "devDependencies": {"@vitejs/plugin-vue": "^6.0.0", "vite": "^7.0.0", "typescript": "~5.9.0", "vue-tsc": "^3.0.0", "vitest": "^3.2.0", "@vue/test-utils": "^2.4.6", "jsdom": "^26.1.0", "eslint": "^9.0.0", "eslint-plugin-vue": "^10.0.0", "typescript-eslint": "^8.0.0", "@eslint/js": "^9.0.0", "prettier": "^3.6.0", "openapi-typescript": "^7.0.0", "@playwright/test": "^1.55.0", "@types/node": "^24.0.0"}
